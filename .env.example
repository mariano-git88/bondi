# Bondi — variables de entorno. Copiá a `.env` y completá.
# El .env está en .gitignore, no se sube al repo.

# Anthropic Console → API Keys. Mismo proyecto que el chat público.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Platform → API Keys. Solo se usa al buildear el index (embeddings).
OPENAI_API_KEY=sk-...

# Password compartida entre operadores del backoffice.
# Protege los endpoints /admin/* del backend y el login del Streamlit.
# CAMBIAR antes de deployar. Default 'admin' si no se setea (INSEGURO).
BONDI_ADMIN_PASS=cambiame-por-favor

# URL del backend (la usa el backoffice Streamlit para "Reload Backend").
# En local: http://localhost:8000
# En prod:  https://bondi-api.onrender.com
BONDI_BACKEND_URL=http://localhost:8000
